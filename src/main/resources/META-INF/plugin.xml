<idea-plugin>
  <id>dev.elide</id>
  <name>Elide</name>
  <vendor url="https://elide.dev" email="engineering@elide.dev">Elide Technologies Inc.</vendor>

  <description><![CDATA[
    <p>
      IDE integration for <a href="https://elide.dev">Elide</a>, a fast batteries-included runtime and build tool with
      support for Kotlin, Java, JavaScript, TypeScript, and Python.
    </p>
    <p>
      A directory containing an <code>elide.pkl</code> manifest is imported like any other external build system: its
      dependencies become IDE libraries, and Elide commands run from the IDE with completion, console output, and
      debugger support.
    </p>
    <ul>
      <li>Import and sync Elide projects, including dependency sources and documentation</li>
      <li>Run configurations for entrypoints declared in the project manifest, with command line completion</li>
      <li>Run and debug JVM <code>main</code> functions and JUnit tests from the editor gutter</li>
      <li>Attach the IDE's Java debugger to the CLI's JDWP server</li>
      <li>Run Elide commands ad hoc through Run Anything</li>
      <li>Select the Elide distribution used per project</li>
      <li>Create new projects from the templates Elide ships, driven by <code>elide init</code></li>
    </ul>
    <p>
      Manifest editing features (completion, navigation and inspections inside <code>elide.pkl</code>) additionally
      require the Pkl language plugin; a forked version with enhanced Elide compatibility is available from the Elide
      plugin repository at <code>https://plugins.elide.dev/intellij</code>, for the original see
      <code>https://pkl-lang.org/intellij/current/installation.html</code>.
    </p>
    <p>
      Source code and issue tracker: <a href="https://github.com/elide-dev/intellij">elide-dev/intellij</a>.
    </p>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.externalSystem</depends>
  <depends>com.intellij.modules.idea</depends>
  <depends>com.intellij.java</depends>
  <depends>org.jetbrains.kotlin</depends>

  <depends optional="true" config-file="plugin-pkl.xml">org.pkl</depends>

  <resource-bundle>i18n.Strings</resource-bundle>

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>

  <extensionPoints>
    <!-- extension point for third-party augmentation of the resolved project model; the plugin itself builds the
         entire model (including SDK selection) in ElideProjectModel -->
    <extensionPoint name="projectModelContributor"
                    interface="dev.elide.intellij.project.model.ElideProjectModelContributor"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <configurationType implementation="dev.elide.intellij.execution.ElideExternalTaskConfigurationType"/>
    <runConfigurationProducer implementation="dev.elide.intellij.execution.ElideRuntimeConfigurationProducer"/>
    <runAnything.executionProvider implementation="dev.elide.intellij.action.ElideRunAnythingProvider"/>
    <executionTargetLanguageRuntimeType implementation="dev.elide.intellij.execution.ElideRuntimeType"/>
    <runConfigurationProducer implementation="dev.elide.intellij.execution.ElideJvmMainConfigurationProducer"/>
    <runConfigurationProducer implementation="dev.elide.intellij.execution.ElideJUnitTestConfigurationProducer"/>
    <!-- `order="first"`: the platform's ExternalSystemTaskDebugRunner claims every ExternalSystemRunConfiguration for
         the Debug executor, and ProgramRunner.getRunner takes the first match in extension order -->
    <programRunner implementation="dev.elide.intellij.execution.ElideDebugRunner" order="first"/>

    <!-- the resolver and task manager run in the IDE process rather than a forked one, so they can use the full
         platform API; `ExternalSystemApiUtil.isInProcessMode` reads exactly this key -->
    <registryKey key="ELIDE.system.in.process"
                 defaultValue="true"
                 description="Run Elide project resolution and tasks inside the IDE process"/>

    <externalSystemUnlinkedProjectAware implementation="dev.elide.intellij.project.ElideUnlinkedProjectAware"/>
    <externalIconProvider key="ELIDE" implementationClass="dev.elide.intellij.ui.ElideIconProvider"/>
    <postStartupActivity implementation="dev.elide.intellij.startup.ElideStartupActivity"/>
    <moduleBuilder builderClass="dev.elide.intellij.wizard.ElideNewProjectWizardBuilder"/>
    <externalSystemManager id="ELIDE" implementation="dev.elide.intellij.ElideManager"/>
    <projectConfigurable
            key="elide"
            id="reference.settingsdialog.project.elide"
            groupId="build.tools"
            instance="dev.elide.intellij.settings.ElideConfigurable"/>
    <externalSystem.runConfigurationEx implementation="dev.elide.intellij.execution.ElideRunConfigurationExtension"/>
    <externalProjectDataService implementation="dev.elide.intellij.project.ElideProjectDataService"/>
    <toolWindow id="Elide"
                factoryClass="dev.elide.intellij.ui.ElideToolWindowFactory"
                anchor="right"
                icon="/icons/toolWindowElide.svg"/>
    <notificationGroup id="Elide Notifications"
                       displayType="BALLOON"
                       key="elide.notifications.group"/>
  </extensions>

  <actions>
    <action id="Elide.Run" class="dev.elide.intellij.action.ElideRunAction" icon="AllIcons.Actions.RunAnything"/>
  </actions>
</idea-plugin>
