<idea-plugin>
  <resource-bundle>i18n.Strings</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <!-- `order="first"`: ElideNativeImageDebugAdvertiser claims the same executor while this module is not loaded,
         and ProgramRunner.getRunner takes the first match in extension order -->
    <programRunner implementation="dev.elide.intellij.execution.nativeimage.debug.ElideNativeImageDebugRunner"
                   order="first"/>
  </extensions>
</idea-plugin>
