<idea-plugin>
  <resource-bundle>i18n.Strings</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <runLineMarkerContributor language="Pkl"
                              implementationClass="dev.elide.intellij.execution.ElideManifestLineMarkerContributor"/>
    <psi.referenceContributor language="Pkl"
                              implementation="dev.elide.intellij.psi.ElideManifestReferencesContributor"/>

    <!-- lets references into string contents follow a rename or move of their target, which the Pkl plugin does not
         support on its own; a `workspace.members` entry is rewritten when its directory moves -->
    <lang.elementManipulator forClass="org.pkl.intellij.psi.PklStringContentBase"
                             implementationClass="dev.elide.intellij.psi.ElideStringContentManipulator"/>

    <!-- `first`: the platform suppresses the popup in every string literal, and workspace strings are the exception -->
    <completion.confidence language="Pkl"
                           order="first"
                           implementationClass="dev.elide.intellij.psi.ElideManifestCompletionConfidence"/>
    <typedHandler implementation="dev.elide.intellij.psi.ElideManifestTypedHandler"/>

    <!-- this producer resolves entrypoints from Pkl PSI, so it can only load when the Pkl plugin is present.
         Order matters: it and the Native Image producer compare equal in preference, so `configurationsFromContext`
         keeps them in registration order, and the gutter reads the native run at index 1 -->
    <runConfigurationProducer
            implementation="dev.elide.intellij.execution.ElideManifestRunConfigurationProducer"/>

    <!-- the second configuration a Native Image key offers, next to the build of the artifact -->
    <runConfigurationProducer
            implementation="dev.elide.intellij.execution.nativeimage.ElideNativeImageConfigurationProducer"/>

    <localInspection language="Pkl"
                     key="elide.inspection.manifest.jvm.unresolvedMainClass.name"
                     groupKey="elide.inspection.manifest.group"
                     enabledByDefault="true"
                     implementationClass="dev.elide.intellij.psi.ElideManifestJvmMainReferenceInspection"/>

    <localInspection language="Pkl"
                     key="elide.inspection.manifest.jvm.invalidMainClass.name"
                     groupKey="elide.inspection.manifest.group"
                     enabledByDefault="true"
                     implementationClass="dev.elide.intellij.psi.ElideManifestJvmMainMethodInspection"/>

    <localInspection language="Pkl"
                     key="elide.inspection.manifest.workspace.name"
                     groupKey="elide.inspection.manifest.group"
                     enabledByDefault="true"
                     level="ERROR"
                     implementationClass="dev.elide.intellij.psi.ElideManifestWorkspaceReferenceInspection"/>
  </extensions>
</idea-plugin>
