<!--
  Registers no extensions: the single effect of this descriptor is putting `intellij.platform.smRunner` on the plugin's
  class path on the builds that own it as a content module, which is the only place the SM test runner classes live
  from 262 on. See the comment on the `depends` element that names this file in `plugin.xml`.
-->
<idea-plugin>
  <dependencies>
    <module name="intellij.platform.smRunner"/>
  </dependencies>
</idea-plugin>
