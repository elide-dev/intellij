<!--
  Content module of the Elide plugin holding the test tree of an `elide test` run, which is the only part of the
  plugin built on the SM test runner. A module dependency is the one way to reach that runner's classes from 262 on,
  where they live in a content module of another plugin, and 253 cannot load the module at all, so the dependency is
  confined to this module and the module is declared optional in `plugin.xml`. See `docs/PLATFORM_APIS.md`.
-->
<idea-plugin package="dev.elide.intellij.execution.test">
  <dependencies>
    <module name="intellij.platform.smRunner"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <!-- renders `elide test` runs as a test tree, decoding the CLI's TAP 13 stream -->
    <externalSystemExecutionConsoleManager
            implementation="dev.elide.intellij.execution.test.ElideTestsExecutionConsoleManager"/>
  </extensions>
</idea-plugin>
