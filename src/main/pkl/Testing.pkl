/// Describes types involved in structuring and running tests and test suites.
@ModuleInfo { minPklVersion = "0.28.1" }
module elide.testing

/// Abstract type specifying a test report.
abstract class TestReport {
  /// Name for this report; typically the format name by default.
  name: String
}

/// Test report in JUnit-compatible XML format.
class XmlTestReport extends TestReport {
  name = "xml"
}

/// Configures a default XML test report.
function xmlReport() = new XmlTestReport { }

/// DSL root type where test settings and configuration are mounted.
class Testing {
  /// Machine-readable test reports requested from each supported language runner.
  reports: Listing<TestReport> = new {}
}
