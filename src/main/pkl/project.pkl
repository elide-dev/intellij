/// Describes an Elide project and its dependencies, build, distribution, and runtime configuration.
@ModuleInfo { minPklVersion = "0.28.1" }
module elide.project

import "pkl:semver" as _semver
import "Artifacts.pkl" as _artifacts
import "Base.pkl" as _common
import "Dev.pkl" as _dev
import "Engine.pkl" as _engine
import "JavaScript.pkl" as _js
import "Jvm.pkl" as _jvm
import "Kotlin.pkl" as _kotlin
import "NativeImage.pkl" as _nativeImage
import "Sources.pkl" as _srcs
import "Testing.pkl" as _testing
import "Toolchain.pkl" as _toolchain
import "Web.pkl" as _web

/// Name of a script within the project's configuration.
typealias ScriptName = String

/// Entrypoint definition.
typealias Entrypoint = Listing<_common.FilePath>

/// A feature set grouping build tasks and other capabilities.
typealias FeatureSet = "kotlin" | "java" | "js"

/// A name for the project.
name: String?

/// Version of the project.
version: String?

/// Optional description for the project, displayed when published as a package.
description: String?

/// Relative path to the source file evaluated by the runtime on startup.
entrypoint: Entrypoint?

/// A script entry: a shell command, a path to a file to run, or a plain string.
typealias ScriptValue = _common.ShellCommand

/// Script mappings; each entry is a name and a script to run.
scripts: Mapping<ScriptName, ScriptValue> = new {}

/// Represents a release channel for the Elide version running the build.
/// @schema ignore
typealias ReleaseChannel = "release" | "debug"

/// Represents a major version of the Elide project manifest format, used to indicate breaking changes.
typealias ManifestVersion = Int(isNonZero && isPositive)

/// Information about the Elide runtime version used during the build.
/// @schema ignore
class ElideInfo {
  /// Release channel of the Elide runtime executing the build.
  channel: ReleaseChannel

  /// Semantic version of the Elide runtime executing the build.
  version: _semver.Version
}

/// State captured from the Elide build system at evaluation time.
/// @schema ignore
class BuildInfo {
  /// Major version of the project manifest format; incremented on breaking schema changes.
  manifestVersion: ManifestVersion
}

/// Information about the current build.
/// @schema ignore
fixed build: BuildInfo = new {
  manifestVersion = read?("prop:elide.build.state.manifestVersion")?.toInt() ?? 1
}

/// Information about the Elide runtime currently executing the build.
/// @schema ignore
fixed elide: ElideInfo = new {
  channel = if (read?("prop:elide.build.state.release") == "true") "release" else "debug"

  local plainVersion = read?("prop:elide.build.state.version")
  version = if (plainVersion != null) _semver.Version(plainVersion) else _semver.Version("0.0.0")
}

//
// ------ Dependencies ----------------------------------------------------------------------------------------------
//

/// NPM package dependency specifier, such as `react@19.0.0` or `@scope/package@1.0.0`.
typealias NpmPackageDependency = String

/// PyPI package dependency specifier, such as `six==1.17.0` or `requests>=2`.
typealias PypiPackageDependency = String

/// Configuration for NPM dependency resolution.
class NpmDependencies {
  /// A list of NPM packages to install for this project.
  packages: Listing<NpmPackageDependency> = new {}

  /// A list of NPM packages to make available at dev-time only.
  devPackages: Listing<NpmPackageDependency> = new {}
}

/// Configuration for PyPI dependency resolution.
class PypiDependencies {
  /// A list of PyPI packages to install for this project.
  packages: Listing<PypiPackageDependency> = new {}

  /// Optional PyPI dependency groups.
  optionalPackages: Mapping<String, Listing<PypiPackageDependency>> = new {}
}

/// Dependency resolution configuration.
class Dependencies {
  /// Configure JVM dependencies using Maven.
  maven: _jvm.MavenDependencies = new {}

  /// Configure JavaScript dependencies using NPM.
  npm: NpmDependencies = new {}

  /// Configure Python dependencies using PyPI.
  pypi: PypiDependencies = new {}

  /// Configure Spring Boot starters; expands into `maven` at manifest parse time.
  spring: _jvm.SpringDependencies?
}

/// Dependency resolution configuration.
dependencies: Dependencies = new {}

//
// ------ Configuration ---------------------------------------------------------------------------------------------
//

/// Configure JVM runtime settings.
jvm: _jvm.JvmSettings?

/// Configure Kotlin language settings.
kotlin: _kotlin.KotlinSettings?

/// Configure JavaScript language settings.
javascript: _js.JavaScriptSettings?

/// Project-wide settings for the Native Image compiler.
nativeImage: _nativeImage.NativeImageSettings?

/// Configuration for the execution engine.
engine: _engine.EngineSettings?

//
// ------ Structure -------------------------------------------------------------------------------------------------
//

/// Top-level project sources definition.
sources: _srcs.Sources = new {
  default = (name) -> new _srcs.SourceSetSpec {
    type = if (name == "test") "test" else "source"
    dependsOn = if (name == "main") new {} else new { "main" }
  }
  ["main"] = "src/**.*"
  ["test"] = "test/**.*"
}

/// Development settings for this project.
dev: _dev.DevSettings = new {}

/// Toolchain settings for this project.
toolchain: _toolchain.ToolchainSettings = new {}

/// Artifacts to be produced by this project.
artifacts: _artifacts.Artifacts = new {}

/// Settings which apply to web-based projects and applications.
web: _web.WebSettings? = new {}

/// Settings for testing features
testing: _testing.Testing = new {}
